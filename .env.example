# Enrolled Kit Reader identity. Configure both values together.
KEYDRIS_API_URL=https://dev.api.keydris.com/
KEYDRIS_MCP_KEY=replace-with-the-installation-key

# Legacy unenrolled credential-redemption fallback.
# KEYDRIS_GATEWAY_URL=https://dev.api.keydris.com/gateway/credentials

# Legacy token header fallback. Normal MCP calls carry the token in _meta.
# KEYDRIS_TOKEN_HEADER=authorization
